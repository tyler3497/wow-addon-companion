{
  "author": "Tyler",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.6.2"
  },
  "description": "Gear Audit companion app for retail World of Warcraft. Starts with an addon updater; built to grow with more features.",
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "license": "UNLICENSED",
  "main": "src/main.js",
  "name": "gear-audit-app",
  "private": true,
  "scripts": {
    "pack:win": "electron-packager . GearAudit --platform=win32 --arch=x64 --out=dist --overwrite --prune=true",
    "start": "electron .",
    "test:core": "node src/core/updater.test.js",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "version": "1.1.0",
  "build": {
    "appId": "com.tyler.gearaudit",
    "productName": "GearAudit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "README.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "tyler3497",
      "repo": "wow-addon-companion"
    }
  }
}
